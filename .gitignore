# =============================================================
#  AgroSustain – .gitignore
# =============================================================

# ──────────────────────────────────────────────
# SECRETS & ENVIRONMENT VARIABLES  ← NEVER COMMIT
# ──────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
# Allow the example template (must come after the deny rules)
!.env.example
!**/.env.example

# ──────────────────────────────────────────────
# PYTHON
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# ──────────────────────────────────────────────
# NODE / REACT / VITE
# ──────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.npm
.yarn/cache
.pnp.*
*.tsbuildinfo

# ──────────────────────────────────────────────
# MACHINE LEARNING – LARGE BINARY FILES
# ──────────────────────────────────────────────
# Trained model weights (can be 100 MB+)
backend/models/*.pth
backend/models/*.pt
backend/models/*.bin
backend/models/*.pkl
backend/models/*.h5
backend/models/*.ckpt
backend/models/*.onnx

# Keep the JSON class-maps that are tiny & needed
!backend/models/*.json

# Root-level YOLO pre-trained weights
*.pt
*.pth

# Datasets (can be gigabytes)
datasets/

# YOLO training runs / artefacts
backend/yolo_runs/

# ──────────────────────────────────────────────
# RUNTIME / TEMPORARY FILES
# ──────────────────────────────────────────────
# User-uploaded images (generated at runtime)
backend/uploads/

# Log files
logs/
*.log
*.log.*

# ──────────────────────────────────────────────
# IDE / EDITOR
# ──────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
# OS FILES
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
